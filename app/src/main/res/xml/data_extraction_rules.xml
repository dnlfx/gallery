<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing the app keeps leaves the phone, by cloud backup or by moving to a new
    phone. The root domain is the app's whole data folder, settings included.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
