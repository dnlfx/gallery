                        <gradient
                            android:type="linear"
                            android:startX="54"
                            android:startY="54"
                            android:endX="54"
                            android:endY="24"
                            android:startColor="#FF8A5B"
                            android:endColor="#8B5CF6" />
                    </aapt:attr>
                </path>
            </group>
        </group>
        <group
