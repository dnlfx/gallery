        </path>
        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="0">
            <group android:translateX="5.5">
                <path
                    android:fillAlpha="0.85"
                    android:pathData="M54,54A16,16 0,0 1,54 24A16,16 0,0 1,54 54Z">
