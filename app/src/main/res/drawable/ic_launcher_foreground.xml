<?xml version="1.0" encoding="utf-8"?>
<!-- Two stacked photos: a sunset print in front, the next one peeking out behind it.
     Everything sits inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.1"
        android:scaleY="1.1">
        <!-- Back photo: only the edge that shows past the front one. -->
        <path
            android:fillColor="#8CFFFFFF"
            android:pathData="M40,34H73A5,5 0,0 1,78 39V64A4,4 0,0 1,74 68V38H36A4,4 0,0 1,40 34Z" />
        <!-- Front photo border. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M35,40H67A5,5 0,0 1,72 45V69A5,5 0,0 1,67 74H35A5,5 0,0 1,30 69V45A5,5 0,0 1,35 40Z" />
        <group>
            <clip-path android:pathData="M36,43H66A3,3 0,0 1,69 46V68A3,3 0,0 1,66 71H36A3,3 0,0 1,33 68V46A3,3 0,0 1,36 43Z" />
            <!-- Sky. -->
            <path android:pathData="M33,43h36v28h-36z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="51"
                        android:startY="43"
                        android:endX="51"
                        android:endY="71"
                        android:startColor="#FFFFC98F"
                        android:endColor="#FFFF7F6E" />
                </aapt:attr>
            </path>
            <!-- Sun. -->
            <path
                android:fillColor="#FFF4CC"
                android:pathData="M61,50m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
            <!-- Far peak. -->
            <path
                android:fillColor="#7C6FE8"
                android:pathData="M45,71L57,56L69,68V71Z" />
            <!-- Near peak. -->
            <path
                android:fillColor="#3B2F9E"
                android:pathData="M33,71V65L42,55L56,71Z" />
        </group>
    </group>
</vector>
